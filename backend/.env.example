# 复制为 .env 后使用；配置统一入口为 backend/app/config.py（.env 只补环境变量中缺失的键）
# 端口已在 port-manager 登记（项目：采购报价对比Agent，服务：api）

# ---- 服务监听 ----
PORT=8002
HOST=127.0.0.1

# ---- 存储 ----
# SQLite 库文件路径，默认 backend/data/quotes.db
# QUOTES_DB_PATH=data/quotes.db
# 报价单原件对象存储：local（默认，本地文件系统内容寻址）/ s3（预留，需装 boto3 后补实现）
# OBJECT_STORE_BACKEND=local
# 对象存储根目录，默认 backend/data/object_store
# OBJECT_STORE_DIR=data/object_store

# ---- 流水线 ----
# 文件级并发解析的最大线程数（一个任务内多个报价文件并行解析），默认 3
# PARSE_CONCURRENCY=3
# LLM-B 核算员影子复核开关：默认开（只记录不生效），0 关闭
# LLM_B_VERIFY=1

# ---- LLM 网关 ----
# OpenAI 兼容网关地址 / 鉴权 key / 单轮超时（秒）/ 模型名
# LLM_BASE_URL=http://localhost:18080/v1
# LLM_API_KEY=local-demo-key
# LLM_TIMEOUT=60
# LLM_MODEL=qwen3.8-max
# 网关为推理模型，默认关思考（延迟低、输出稳定）；需要 reasoning 时设 1
# LLM_ENABLE_THINKING=0
